<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">



     <servlet>
     	<servlet-name>InsertServlet</servlet-name>
     	<servlet-class>VideoBrowsing.InsertServlet</servlet-class>
     </servlet>
     
     <servlet-mapping>
     	<servlet-name>InsertServlet</servlet-name >
     	<url-pattern>/InsertServlet</url-pattern>
     </servlet-mapping>
     
      <servlet>
     	<servlet-name>GetAllServlet</servlet-name>
     	<servlet-class>VideoBrowsing.GetAllServlet</servlet-class>
     </servlet>
     
     <servlet-mapping>
     	<servlet-name>GetAllServlet</servlet-name >
     	<url-pattern>/GetAllServlet</url-pattern>
     </servlet-mapping>
     
     <servlet>
        <servlet-name>VideoViewServlet</servlet-name>
        <servlet-class>VideoBrowsing.VideoViewServlet</servlet-class>
     </servlet>
     
     <servlet-mapping>
        <servlet-name>VideoViewServlet</servlet-name>
        <url-pattern>/VideoViewServlet</url-pattern>
     </servlet-mapping>
     
      <servlet>
        <servlet-name>UpdateServlet</servlet-name>
        <servlet-class>VideoBrowsing.UpdateServlet</servlet-class>
     </servlet>
     
     <servlet-mapping>
        <servlet-name>UpdateServlet</servlet-name>
        <url-pattern>/UpdateServlet</url-pattern>
     </servlet-mapping>

    <!-- Add resource mapping for videos directory -->
    <servlet-mapping>
        <servlet-name>default</servlet-name>
        <url-pattern>/videos/*</url-pattern>
    </servlet-mapping>

</web-app>